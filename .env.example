# Copy to `.env.local` and fill in. `.env.local` is gitignored.
#
# Both of these are safe to ship in the browser bundle: the anon key only ever
# grants what RLS allows. The service_role key must NEVER appear here — Edge
# Functions receive it automatically from the platform.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Web push (Phase 2). Generate with: npx web-push generate-vapid-keys
# Only the public key belongs on the client.
VITE_VAPID_PUBLIC_KEY=
