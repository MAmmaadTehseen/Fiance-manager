<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Merged into the app manifest by the Android Gradle plugin. -->

  <application>
    <!--
      Manifest-registered, so Android starts the process to deliver an SMS
      even when the app has been killed or force-stopped-then-relaunched.
      A receiver registered from JS would only ever fire while the app runs,
      which is almost never when a bank texts you.
    -->
    <receiver
      android:name=".SmsReceiver"
      android:enabled="true"
      android:exported="true"
      android:permission="android.permission.BROADCAST_SMS">
      <intent-filter android:priority="999">
        <action android:name="android.provider.Telephony.SMS_RECEIVED" />
      </intent-filter>
    </receiver>

    <!--
      Fallback path, and the one that stays viable on Google Play: reading the
      notification your SMS app posts is not covered by the restricted
      SMS/Call Log policy. It also catches banks that push through their own
      app rather than by text.

      The label comes from the app's own name rather than a fixed string:
      dev and production are separate installs, and Android's
      notification-access screen lists services by this label — hard-coding
      "Batwa" showed two identical rows with no way to tell them apart.
    -->
    <service
      android:name=".BatwaNotificationListener"
      android:exported="true"
      android:label="@string/app_name"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
  </application>
</manifest>
