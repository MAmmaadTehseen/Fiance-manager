{
  "name": "batwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @batwa/web",
    "build": "npm run build -w @batwa/web",
    "preview": "npm run preview -w @batwa/web",
    "lint": "npm run lint -w @batwa/web",
    "typecheck": "npm run typecheck -w @batwa/core && npm run typecheck -w @batwa/web",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/core/src/types/database.types.ts",
    "functions:serve": "supabase functions serve",
    "test:rls": "bash supabase/tests/rls.sh",
    "test:parser": "bash supabase/tests/parser.sh",
    "test:ingest": "bash supabase/tests/ingest.sh",
    "assets:icons": "node scripts/make-icons.mjs ./apps/web/public",
    "assets:og": "node scripts/make-og-card.mjs ./apps/web/public"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.13.3",
    "supabase": "^2.115.0",
    "typescript": "~6.0.2"
  }
}
